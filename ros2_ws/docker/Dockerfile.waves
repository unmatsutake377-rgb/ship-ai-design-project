# ship-sim + asv_wave_sim (gz-waves) — 파랑 세계 (내항 교차 검증)
FROM ship-sim:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg lsb-release ca-certificates \
    && curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
       -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
       > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential pkg-config \
    libgz-sim8-dev libfftw3-dev libeigen3-dev libcgal-dev \
    libboost-iostreams-dev libboost-system-dev libboost-filesystem-dev \
    && rm -rf /var/lib/apt/lists/*

ENV GZ_VERSION=harmonic
WORKDIR /opt
RUN git clone --depth 1 https://github.com/srmainwaring/asv_wave_sim.git
RUN cd asv_wave_sim/gz-waves \
    && mkdir build && cd build \
    && (cmake .. -DCMAKE_BUILD_TYPE=Release > /tmp/cm.log 2>&1 \
        || (tail -40 /tmp/cm.log && false)) \
    && (make -j4 > /tmp/mk.log 2>&1 \
        || (tail -60 /tmp/mk.log && false)) \
    && make install

ENV GZ_SIM_SYSTEM_PLUGIN_PATH=/usr/local/lib
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN ldconfig
